---
import BlogLayout from '../layouts/BlogLayout.astro';
const landingUrl = import.meta.env.PUBLIC_LANDING_URL || 'https://devblog33.vercel.app';
---
<BlogLayout
  title="Diego Cortés Hernández — Dev Blog & Notes"
  description="Dev blog, engineering notes, tutorials, and personal reflections by Diego Cortés Hernández."
  activePage="home"
  indicator="00 / spectrum hub"
  backHref={landingUrl}
  backLabel="landing cv"
>

  <!-- ============================================================
       MINIMAL HUB HERO + PERSISTENT 3D WEBGL PRISM
       ============================================================ -->
  <section class="hero hero--minimal" id="hub" data-section-indicator="00 / spectrum hub">
    <div class="hero__bg is-ready" aria-hidden="true">
      <div class="hero__scanlines"></div>
      <div class="hero__grain"></div>
      <div class="hero__vignette"></div>
    </div>

    <div class="hub-minimal">
      <h1 class="hub-minimal__name reveal">
        <span class="name-glitch">Diego Cortés Hernández</span>
      </h1>

      <p class="hub-minimal__subtitle reveal">Dev blog &amp; notes</p>

      <a href="/thoughts" class="hub-minimal__cta reveal" data-nav data-prism-hover="tutorials">
        <span>read thoughts</span>
        <span class="hub-minimal__cta-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="hub-minimal__footer reveal">
      Code, experiments &amp; notes.
    </div>
  </section>
</BlogLayout>
