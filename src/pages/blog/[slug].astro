---
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlockRenderer from '../../components/BlockRenderer.astro';
import AuthorSignature from '../../components/AuthorSignature.astro';
import { getPublishedBlogArticles, type BlogArticle } from '../../lib/cms';

export async function getStaticPaths() {
  const articles = await getPublishedBlogArticles();
  return articles.map((article, index) => ({
    params: { slug: article.slug },
    props: {
      article,
      allArticles: articles,
      nextArticle: articles[(index + 1) % articles.length] || null,
    },
  }));
}

interface Props {
  article: BlogArticle;
  allArticles: BlogArticle[];
  nextArticle: BlogArticle | null;
}

const { article, allArticles = [], nextArticle } = Astro.props;

const CAT_META: Record<
  BlogArticle['category'],
  { color: string; short: string; wavelength: string }
> = {
  personal: { color: '#ff6b81', short: 'personal', wavelength: 'λ 650nm · personal' },
  opinions: { color: '#f5c542', short: 'opinion', wavelength: 'λ 590nm · opinion' },
  tutorials: { color: '#3ddbd9', short: 'tutorial', wavelength: 'λ 490nm · tutorial' },
  architecture: { color: '#7c8cff', short: 'case study', wavelength: 'λ 410nm · case study' },
};

const meta = CAT_META[article.category] || CAT_META.tutorials;
const otherArticles = allArticles.filter((a) => a.slug !== article.slug);
---
<BlogLayout
  title={`${article.title} — Diego Cortés Hernandez`}
  description={article.lead}
  activePage="article"
  indicator={`${article.counterNum} / ${meta.short}`}
  backHref="/thoughts"
  backLabel="thoughts"
>
  <section
    class="th2 th2-reader subpage-hero"
    id="articleHero"
    data-category={article.category}
    style={`--cat-color: ${meta.color}`}
  >
    <div class="thoughts__bg" aria-hidden="true">
      <div class="thoughts__bg-overlay th2__bg-overlay"></div>
    </div>

    <div class="th2-reader__workbench">
      <!-- ==================== ZONE 1 (LEFT EDGE): SCHEMATIC PRISM + READING PROGRESS + LIVE TOC ==================== -->
      <aside class="th2-reader__left">
        <a href="/thoughts" class="th2-reader__back" data-nav>
          <span aria-hidden="true">&larr;</span>
          <span>all thoughts</span>
        </a>

        <div class="th2__diagram" data-active-ray={article.category}>
          <svg
            aria-hidden="true"
            viewBox="0 0 340 120"
            width="280"
            height="98"
            class="th2__svg"
          >
            <line class="th2__beam-in" x1="0" y1="70" x2="128" y2="70" stroke="#fff" stroke-width="1.5" />
            <line class="th2__beam-core" x1="128" y1="70" x2="172" y2="70" stroke="rgba(255,255,255,0.28)" stroke-width="1.2" stroke-dasharray="2 3" />
            <polygon class="th2__prism-poly" points="150,18 205,102 95,102" fill="none" stroke="#4a4752" stroke-width="1.2" />
            <line class="th2__ray" data-ray="personal" x1="172" y1="70" x2="340" y2="34" stroke="#ff6b81" stroke-width="1.5" />
            <line class="th2__ray" data-ray="opinions" x1="172" y1="70" x2="340" y2="56" stroke="#f5c542" stroke-width="1.5" />
            <line class="th2__ray" data-ray="tutorials" x1="172" y1="70" x2="340" y2="78" stroke="#3ddbd9" stroke-width="1.5" />
            <line class="th2__ray" data-ray="architecture" x1="172" y1="70" x2="340" y2="100" stroke="#7c8cff" stroke-width="1.5" />
          </svg>
          <div class="th2__wavelength">
            <span class="th2__wavelength-dot" style={`background:${meta.color};box-shadow:0 0 10px ${meta.color}`}></span>
            <span style={`color:${meta.color}`}>{meta.wavelength}</span>
          </div>
        </div>

        <!-- Live Reading Progress Meter -->
        <div class="th2-reader__progress-card">
          <div class="th2-reader__progress-head">
            <span>reading progress</span>
            <span id="th2ReadPercent" style={`color:${meta.color}`}>0%</span>
          </div>
          <div class="th2-reader__progress-track">
            <div class="th2-reader__progress-fill" id="th2ReadFill" style={`background:${meta.color}`}></div>
          </div>
        </div>

        <!-- Section Outline (Interactive Scroll-Spy TOC) -->
        {article.toc && article.toc.length > 0 && (
          <nav class="th2-reader__toc" aria-label="Table of contents">
            <div class="th2-reader__toc-title">&gt; sections // outline</div>
            <ol class="th2-reader__toc-list" id="th2ReaderTocList">
              {article.toc.map((sec, idx) => (
                <li>
                  <a
                    href={`#${sec.id}`}
                    class:list={['th2-reader__toc-link', { 'is-active': idx === 0 }]}
                    data-toc-target={sec.id}
                  >
                    <span class="th2-reader__toc-dot"></span>
                    <span class="th2-reader__toc-num">{String(idx + 1).padStart(2, '0')}</span>
                    <span class="th2-reader__toc-label">{sec.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}
      </aside>

      <!-- ==================== ZONE 2 (WIDE CENTER): FULL THOUGHT OPTICAL SPINE ==================== -->
      <div class="th2-reader__center" id="articleBody">
        <div class="th2__spine th2-reader__spine">
          <!-- Thought Header on the Spine -->
          <header class="th2-reader__header">
            <span class="th2__dot th2__dot--featured" style={`background:${meta.color}`}></span>
            <div class="th2__meta" style={`color:${meta.color}`}>
              <span>{article.counterNum}</span>
              <span>&middot;</span>
              <span>{meta.short}</span>
              <span>&middot;</span>
              <span>{article.dateDisplay}</span>
              <span>&middot;</span>
              <span>{article.readingTime} min read</span>
            </div>

            <h1 class="th2-reader__title">
              {article.heroTitle}
              {article.heroSubtitle && <span class="th2-reader__subtitle-em"> {article.heroSubtitle}</span>}
            </h1>

            <p class="th2-reader__lead">{article.lead}</p>

            <div class="th2-reader__header-actions">
              <a
                href={`#${article.toc?.[0]?.id || 'articleBody'}`}
                class="th2__featured-cta"
                style={`border-bottom-color:${meta.color}`}
              >
                start reading &darr;
              </a>
              {article.repoUrl && (
                <a
                  href={article.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="th2-reader__repo-link"
                >
                  <span>view source repository</span>
                  <span aria-hidden="true">&nearr;</span>
                </a>
              )}
            </div>
          </header>

          <!-- Full Article Content Blocks Along the Spine -->
          <BlockRenderer blocks={article.blocks} accentColor={meta.color} />

          <!-- Author Signature & End Quote -->
          <footer class="th2-reader__footer">
            <AuthorSignature roleSummary={article.roleSummary} publishedAt={article.dateDisplay} />
            <p class="th2__quote">
              &ldquo;The code compiles, but the real question is &mdash; did you learn something today?&rdquo;
            </p>
          </footer>
        </div>
      </div>

      <!-- ==================== ZONE 3 (RIGHT EDGE): THREAD SPECS & SPECTRUM SWITCHER ==================== -->
      <aside class="th2-reader__right">
        <div class="th2-reader__card">
          <div class="th2__inspector-label">&gt; thread_telemetry // specs</div>
          <dl class="th2-reader__specs">
            <div>
              <dt>spectrum</dt>
              <dd style={`color:${meta.color}`}>{meta.wavelength}</dd>
            </div>
            <div>
              <dt>published</dt>
              <dd>{article.dateDisplay}</dd>
            </div>
            <div>
              <dt>reading time</dt>
              <dd>{article.readingTime} min</dd>
            </div>
            <div>
              <dt>domain</dt>
              <dd>{article.roleSummary}</dd>
            </div>
          </dl>

          <div class="th2-reader__quick-actions">
            <button
              type="button"
              class="th2__inspector-copy"
              data-copy-href={`/blog/${article.slug}`}
            >
              [ copy thread link ]
            </button>
            <button
              type="button"
              class="th2__inspector-copy"
              data-scroll-top
            >
              [ &uarr; top ]
            </button>
          </div>
        </div>

        {otherArticles.length > 0 && (
          <div class="th2-reader__card">
            <div class="th2__inspector-label">&gt; other_wavelengths // switch thread</div>
            <div class="th2-reader__switcher">
              {otherArticles.map((other) => {
                const oMeta = CAT_META[other.category] || CAT_META.tutorials;
                return (
                  <a
                    href={`/blog/${other.slug}`}
                    class="th2-reader__switch-item"
                    data-nav
                  >
                    <span class="th2-reader__switch-dot" style={`background:${oMeta.color}`}></span>
                    <div class="th2-reader__switch-body">
                      <span class="th2-reader__switch-cat" style={`color:${oMeta.color}`}>
                        {oMeta.short} &middot; {other.readingTime} min
                      </span>
                      <span class="th2-reader__switch-title">{other.title}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        {nextArticle && nextArticle.slug !== article.slug && (
          <a
            href={`/blog/${nextArticle.slug}`}
            class="th2-reader__next-card"
            style={`border-color:${(CAT_META[nextArticle.category] || meta).color}`}
            data-nav
          >
            <span class="th2-reader__next-eyebrow">next on spectrum &rarr;</span>
            <span class="th2-reader__next-title">{nextArticle.title}</span>
          </a>
        )}
      </aside>
    </div>
  </section>
</BlogLayout>
