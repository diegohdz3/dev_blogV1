---
import BlogLayout from '../layouts/BlogLayout.astro';
import { getPublishedBlogArticles, type BlogArticle } from '../lib/cms';

const rawArticles = await getPublishedBlogArticles();

const SEED_ORDER: Record<string, number> = {
  'psychology-and-software-development': 1,
  'sql-queries-inside-an-api': 2,
  'fullstack-with-a-broken-heart': 3,
  'bakingdesk-integrated-project-case-study': 4,
};

const articles = [...rawArticles].sort((a, b) => {
  const oa = SEED_ORDER[a.slug] ?? 0;
  const ob = SEED_ORDER[b.slug] ?? 0;
  if (oa === 0 && ob === 0) return String(b.publishedAt).localeCompare(String(a.publishedAt));
  if (oa === 0) return -1;
  if (ob === 0) return 1;
  return oa - ob;
});

const CAT_META: Record<
  BlogArticle['category'],
  { color: string; short: string; wavelength: string; nm: string }
> = {
  personal: { color: '#ff6b81', short: 'personal', wavelength: 'λ 650nm · personal', nm: '650nm' },
  opinions: { color: '#f5c542', short: 'opinion', wavelength: 'λ 590nm · opinion', nm: '590nm' },
  tutorials: { color: '#3ddbd9', short: 'tutorial', wavelength: 'λ 490nm · tutorial', nm: '490nm' },
  architecture: { color: '#7c8cff', short: 'case study', wavelength: 'λ 410nm · case study', nm: '410nm' },
};

function shortDate(dateStr: string): string {
  return String(dateStr || '').replace(/,\s*\d{4}$/, '');
}

function buildPanelView(filter: 'all' | BlogArticle['category']) {
  if (filter === 'all') {
    const featured = articles[0] || null;
    const rows = articles.slice(1).map((a, idx) => ({
      article: a,
      num: String(idx + 2).padStart(2, '0'),
      dimmed: false,
    }));
    return { featured, rows };
  }
  const matching = articles.filter((a) => a.category === filter);
  const others = articles.filter((a) => a.category !== filter);
  const featured = matching[0] || articles[0] || null;
  const restMatching = matching.slice(1).map((a, idx) => ({
    article: a,
    num: String(idx + 2).padStart(2, '0'),
    dimmed: false,
  }));
  const restOthers = others
    .filter((a) => a.slug !== featured?.slug)
    .map((a, idx) => ({
      article: a,
      num: String(restMatching.length + idx + 2).padStart(2, '0'),
      dimmed: true,
    }));
  return { featured, rows: [...restMatching, ...restOthers] };
}

const panels: Array<{ id: string; key: 'all' | BlogArticle['category']; active: boolean }> = [
  { id: 'panelAll', key: 'all', active: true },
  { id: 'panelPersonal', key: 'personal', active: false },
  { id: 'panelOpinions', key: 'opinions', active: false },
  { id: 'panelTutorials', key: 'tutorials', active: false },
  { id: 'panelArchitecture', key: 'architecture', active: false },
];

const counts = {
  all: articles.length,
  personal: articles.filter((a) => a.category === 'personal').length,
  opinions: articles.filter((a) => a.category === 'opinions').length,
  tutorials: articles.filter((a) => a.category === 'tutorials').length,
  architecture: articles.filter((a) => a.category === 'architecture').length,
};

const totalMinutes = articles.reduce((acc, a) => acc + (Number(a.readingTime) || 6), 0);
---
<BlogLayout
  title="Thoughts — Diego Cortés Hernandez · Dev Blog"
  description="Code, discipline and human psychology — tutorials, opinions, personal reflections and case studies."
  activePage="thoughts"
  indicator="01 / thoughts"
  backHref="/"
  backLabel="hub"
>
  <section class="thoughts th2 subpage-hero" id="thoughts" data-section-indicator="01 / thoughts">
    <div class="thoughts__bg" aria-hidden="true">
      <div class="thoughts__bg-overlay th2__bg-overlay"></div>
    </div>

    <div class="th2__workbench">
      <!-- ==================== LEFT COLUMN: FULL-HEIGHT 1080P ANIMATED PRISM & SPECTRUM CONTROLS ==================== -->
      <aside class="th2__left">
        <div class="th2__diagram" id="th2Diagram" data-active-ray="all">
          <svg
            id="th2PrismSvg"
            aria-hidden="true"
            viewBox="0 0 340 120"
            width="420"
            height="148"
            class="th2__svg"
          >
            <defs>
              <linearGradient id="th2CoreGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85" />
                <stop offset="100%" stop-color="#3ddbd9" stop-opacity="0.45" />
              </linearGradient>
              <linearGradient id="th2PrismFill" x1="50%" y1="0%" x2="50%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" stop-opacity="0.07" />
                <stop offset="100%" stop-color="#7c8cff" stop-opacity="0.015" />
              </linearGradient>
            </defs>

            <line class="th2__beam-in" x1="0" y1="70" x2="123" y2="70" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" />
            <line class="th2__beam-pulse" x1="0" y1="70" x2="123" y2="70" stroke="#ffffff" stroke-width="2" />

            <polygon class="th2__caustic" points="123,70 175,60 175,80" fill="url(#th2CoreGrad)" opacity="0.32" />
            <line class="th2__beam-core" id="th2BeamCore" x1="123" y1="70" x2="174" y2="68" stroke="url(#th2CoreGrad)" stroke-width="1.6" />

            <polygon class="th2__prism-glow" points="150,18 205,102 95,102" fill="url(#th2PrismFill)" stroke="#5e5a68" stroke-width="1.25" />
            <polygon class="th2__prism-trace" points="150,18 205,102 95,102" fill="none" stroke="#ffffff" stroke-width="1.35" />

            <circle class="th2__node-in" cx="123" cy="70" r="2.2" fill="#ffffff" />
            <circle class="th2__node-out" cx="174" cy="68" r="2" fill="#ffffff" opacity="0.75" />

            <g class="th2__ray-group" data-ray="personal">
              <line class="th2__ray" x1="174" y1="68" x2="340" y2="34" stroke="#ff6b81" stroke-width="1.5" />
              <line class="th2__ray-flow th2__ray-flow--1" x1="174" y1="68" x2="340" y2="34" stroke="#ff94a4" stroke-width="2.2" />
            </g>
            <g class="th2__ray-group" data-ray="opinions">
              <line class="th2__ray" x1="174" y1="68" x2="340" y2="56" stroke="#f5c542" stroke-width="1.5" />
              <line class="th2__ray-flow th2__ray-flow--2" x1="174" y1="68" x2="340" y2="56" stroke="#ffe082" stroke-width="2.2" />
            </g>
            <g class="th2__ray-group" data-ray="tutorials">
              <line class="th2__ray" x1="174" y1="68" x2="340" y2="78" stroke="#3ddbd9" stroke-width="1.5" />
              <line class="th2__ray-flow th2__ray-flow--3" x1="174" y1="68" x2="340" y2="78" stroke="#88f7f5" stroke-width="2.2" />
            </g>
            <g class="th2__ray-group" data-ray="architecture">
              <line class="th2__ray" x1="174" y1="68" x2="340" y2="100" stroke="#7c8cff" stroke-width="1.5" />
              <line class="th2__ray-flow th2__ray-flow--4" x1="174" y1="68" x2="340" y2="100" stroke="#aeb8ff" stroke-width="2.2" />
            </g>
          </svg>
          <div class="th2__wavelength" id="th2Wavelength">
            <span class="th2__wavelength-dot" id="th2WavelengthDot"></span>
            <span id="th2WavelengthText">λ 380–700nm · full spectrum</span>
          </div>
        </div>

        <h1 class="th2__title">thoughts</h1>
        <p class="th2__sub">
          Code, discipline and human psychology. Reflections on software architecture, backend systems, and the human side of engineering.
        </p>

        <div class="th2__segs" role="tablist" aria-label="Thought categories">
          <button
            type="button"
            class="th2__seg thoughts__tab is-active"
            data-tab="all"
            data-color="#ffffff"
            data-wavelength="λ 380–700nm · full spectrum"
            id="tabAll"
            role="tab"
            aria-selected="true"
          >
            <i style="background:#fff"></i>
            <span class="th2__seg-label">all</span>
            <span class="thoughts__tab-count th2__seg-count">{String(counts.all).padStart(2, '0')}</span>
          </button>

          <button
            type="button"
            class="th2__seg thoughts__tab"
            data-tab="personal"
            data-color="#ff6b81"
            data-wavelength="λ 650nm · personal"
            id="tabPersonal"
            role="tab"
            aria-selected="false"
          >
            <i style="background:#ff6b81"></i>
            <span class="th2__seg-label">personal</span>
            <span class="thoughts__tab-count th2__seg-count">{String(counts.personal).padStart(2, '0')}</span>
          </button>

          <button
            type="button"
            class="th2__seg thoughts__tab"
            data-tab="opinions"
            data-color="#f5c542"
            data-wavelength="λ 590nm · opinion"
            id="tabOpinions"
            role="tab"
            aria-selected="false"
          >
            <i style="background:#f5c542"></i>
            <span class="th2__seg-label">opinion</span>
            <span class="thoughts__tab-count th2__seg-count">{String(counts.opinions).padStart(2, '0')}</span>
          </button>

          <button
            type="button"
            class="th2__seg thoughts__tab"
            data-tab="tutorials"
            data-color="#3ddbd9"
            data-wavelength="λ 490nm · tutorial"
            id="tabTutorials"
            role="tab"
            aria-selected="false"
          >
            <i style="background:#3ddbd9"></i>
            <span class="th2__seg-label">tutorial</span>
            <span class="thoughts__tab-count th2__seg-count">{String(counts.tutorials).padStart(2, '0')}</span>
          </button>

          <button
            type="button"
            class="th2__seg thoughts__tab"
            data-tab="architecture"
            data-color="#7c8cff"
            data-wavelength="λ 410nm · case study"
            id="tabArchitecture"
            role="tab"
            aria-selected="false"
          >
            <i style="background:#7c8cff"></i>
            <span class="th2__seg-label">case study</span>
            <span class="thoughts__tab-count th2__seg-count">{String(counts.architecture).padStart(2, '0')}</span>
          </button>
        </div>

        <div class="th2__search-line">
          <span class="th2__search-prefix">/</span>
          <input
            type="search"
            id="th2SearchInput"
            class="th2__search-input"
            placeholder="filter threads, topics or chapters..."
            autocomplete="off"
            aria-label="Filter thoughts"
          />
          <span class="th2__search-meta" id="th2TotalCount">{String(counts.all).padStart(2, '0')} · {totalMinutes}m</span>
        </div>

        <!-- Frameless Optical Spectrum Legend (Fills lower-left vertical space on 1080p) -->
        <div class="th2__spectrum-legend">
          <div class="th2__legend-row">
            <span class="th2__legend-dot" style="background:#ff6b81"></span>
            <span class="th2__legend-nm">650nm</span>
            <span class="th2__legend-name">personal &amp; life in code</span>
          </div>
          <div class="th2__legend-row">
            <span class="th2__legend-dot" style="background:#f5c542"></span>
            <span class="th2__legend-nm">590nm</span>
            <span class="th2__legend-name">psychology &amp; opinions</span>
          </div>
          <div class="th2__legend-row">
            <span class="th2__legend-dot" style="background:#3ddbd9"></span>
            <span class="th2__legend-nm">490nm</span>
            <span class="th2__legend-name">backend &amp; sql tutorials</span>
          </div>
          <div class="th2__legend-row">
            <span class="th2__legend-dot" style="background:#7c8cff"></span>
            <span class="th2__legend-nm">410nm</span>
            <span class="th2__legend-name">architecture case studies</span>
          </div>
        </div>
      </aside>

      <!-- ==================== RIGHT WIDE AREA: FULL 1920x1080 EXPANDED OPTICAL SPINE ==================== -->
      <div class="th2__center">
        <div class="thoughts__panels th2__panels">
          {panels.map((p) => {
            const { featured, rows } = buildPanelView(p.key);
            const fMeta = featured ? CAT_META[featured.category] : CAT_META.opinions;
            return (
              <div
                class:list={['thoughts__panel', 'th2__panel', { 'is-active panel-enter': p.active }]}
                data-panel={p.key}
                id={p.id}
              >
                <div class="thoughts__feed th2__spine">
                  {featured && (
                    <article
                      class="th2__featured"
                      data-category={featured.category}
                      data-prism-hover={featured.category}
                      data-search-text={`${featured.title} ${featured.lead} ${fMeta.short}`.toLowerCase()}
                      style={`--cat-color: ${fMeta.color}`}
                    >
                      <span class="th2__dot th2__dot--featured" style={`background:${fMeta.color}`}></span>

                      <div class="th2__featured-head">
                        <div class="th2__meta" style={`color:${fMeta.color}`}>
                          <span>01</span>
                          <span>&middot;</span>
                          <span>{fMeta.short}</span>
                          <span>&middot;</span>
                          <span>{featured.dateDisplay}</span>
                          <span>&middot;</span>
                          <span>{featured.readingTime} min read</span>
                        </div>
                        <span class="th2__featured-wavelength">{featured.roleSummary} &middot; {fMeta.wavelength}</span>
                      </div>

                      <h2 class="th2__featured-title">
                        <a href={`/blog/${featured.slug}`} data-nav>{featured.title}</a>
                      </h2>

                      <div class="th2__featured-grid">
                        <div class="th2__featured-main">
                          <p class="th2__featured-lead">{featured.lead}</p>
                          <a
                            href={`/blog/${featured.slug}`}
                            class="th2__featured-cta"
                            style={`border-bottom-color:${fMeta.color}`}
                            data-nav
                          >
                            read thread &rarr;
                          </a>
                        </div>

                        {featured.toc && featured.toc.length > 0 && (
                          <div class="th2__featured-chapters">
                            <span class="th2__chapters-label">/ chapters inside this thread</span>
                            <div class="th2__chapters-list">
                              {featured.toc.slice(0, 4).map((sec, sIdx) => (
                                <a href={`/blog/${featured.slug}#${sec.id}`} class="th2__chapter-link" data-nav>
                                  <span class="th2__chapter-num">{String(sIdx + 1).padStart(2, '0')}</span>
                                  <span>{sec.label}</span>
                                </a>
                              ))}
                            </div>
                          </div>
                        )}
                      </div>
                    </article>
                  )}

                  <div class="th2__rows">
                    {rows.map(({ article, num, dimmed }) => {
                      const rMeta = CAT_META[article.category];
                      return (
                        <article
                          class:list={['th2__row', { 'th2__row--dimmed': dimmed }]}
                          data-category={article.category}
                          data-prism-hover={article.category}
                          data-search-text={`${article.title} ${article.lead} ${rMeta.short}`.toLowerCase()}
                          style={`--cat-color: ${rMeta.color}`}
                        >
                          <span class="th2__dot" style={`background:${rMeta.color}`}></span>
                          <span class="th2__num">{num}</span>

                          <div class="th2__row-primary">
                            <a class="th2__ttl" href={`/blog/${article.slug}`} data-nav>
                              {article.title}
                            </a>
                            <span class="th2__row-role">{article.roleSummary}</span>
                          </div>

                          <div class="th2__row-middle">
                            <p class="th2__row-lead">{article.lead}</p>
                            {article.toc && article.toc.length > 0 && (
                              <div class="th2__row-chapters">
                                {article.toc.slice(0, 3).map((sec, sIdx) => (
                                  <a href={`/blog/${article.slug}#${sec.id}`} data-nav>
                                    <span>{String(sIdx + 1).padStart(2, '0')}</span> {sec.label}
                                  </a>
                                ))}
                              </div>
                            )}
                          </div>

                          <div class="th2__row-right">
                            <span class="th2__row-cat" style={`color:${rMeta.color}`}>
                              {rMeta.short} &middot; {article.readingTime} min
                            </span>
                            <span class="th2__date">{shortDate(article.dateDisplay)}</span>
                            <a href={`/blog/${article.slug}`} class="th2__row-go" style={`color:${rMeta.color}`} data-nav>
                              read &rarr;
                            </a>
                          </div>
                        </article>
                      );
                    })}
                    <div class="th2__rows-end"></div>
                  </div>

                  <div class="th2__footer-bar">
                    <p class="th2__quote">
                      &ldquo;The code compiles, but the real question is &mdash; did you learn something today?&rdquo;
                    </p>
                    <span class="th2__footer-sig">diego cortés hernández // full-spectrum notes</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</BlogLayout>
