---
interface Props {
  initialCategory?: 'all' | 'tutorials' | 'opinions' | 'personal' | 'architecture';
  initialMode?: 'spectrum' | 'overdrive' | 'xray' | 'eclipse';
  showHud?: boolean;
}

const {
  initialCategory = 'all',
  initialMode = 'spectrum',
  showHud = true,
} = Astro.props;
---
<div
  class="prism-backdrop"
  id="prismBackdrop"
  transition:persist="prism-backdrop"
  data-prism-category={initialCategory}
  data-prism-mode={initialMode}
  aria-hidden="true"
>
  <div class="prism-backdrop__stars"></div>
  <img
    class="prism-backdrop__fallback"
    src="/images/prism-spectrum.svg"
    alt=""
    width="800"
    height="800"
    fetchpriority="high"
  />
  <canvas class="prism-backdrop__canvas"></canvas>
  <div class="prism-backdrop__scanlines"></div>
  <div class="prism-backdrop__veil"></div>
</div>

{showHud && (
  <aside class="prism-hud" id="prismHud" transition:persist="prism-hud" aria-label="Interactive 3D Prism Controls">
    <div class="prism-hud__status">
      <span class="prism-hud__dot" id="prismHudDot"></span>
      <span class="prism-hud__wavelength" id="prismWavelength">λ 380–750nm · SPECTRUM</span>
    </div>

    <div class="prism-hud__controls" role="group" aria-label="Prism visual modes">
      <!-- spectrum: white beam in, rainbow out -->
      <button type="button" class="prism-hud__btn is-active" data-prism-mode-btn="spectrum" data-tip="spectrum" aria-label="Spectrum mode">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <line x1="1" y1="14" x2="9" y2="12" stroke="#f5faff" stroke-width="1.4" />
          <polygon points="12,4 6.5,18 17.5,18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
          <line x1="15" y1="10.5" x2="23" y2="7" stroke="#ff304d" stroke-width="1.3" />
          <line x1="15.5" y1="12" x2="23" y2="10.5" stroke="#ffb74d" stroke-width="1.3" />
          <line x1="16" y1="13.5" x2="23" y2="14" stroke="#08f7fe" stroke-width="1.3" />
          <line x1="16.5" y1="15" x2="23" y2="17.5" stroke="#a083fa" stroke-width="1.3" />
        </svg>
      </button>
      <!-- overdrive: radiating energy burst -->
      <button type="button" class="prism-hud__btn" data-prism-mode-btn="overdrive" data-tip="overdrive" aria-label="Overdrive mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3.2" />
          <path d="M12 2v3.5M12 18.5V22M2 12h3.5M18.5 12H22M4.9 4.9l2.5 2.5M16.6 16.6l2.5 2.5M4.9 19.1l2.5-2.5M16.6 7.4l2.5-2.5" />
        </svg>
      </button>
      <!-- x-ray: wireframe crystal with scanline -->
      <button type="button" class="prism-hud__btn" data-prism-mode-btn="xray" data-tip="x-ray" aria-label="X-ray mode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12,3 4,19 20,19" stroke-dasharray="2.2 1.6" />
          <path d="M12 3v16M12 19L8 11M12 19l4-8" opacity="0.55" />
          <line x1="2" y1="13" x2="22" y2="13" stroke-width="1" opacity="0.9" />
        </svg>
      </button>
      <!-- eclipse: moon passing over a light source -->
      <button type="button" class="prism-hud__btn" data-prism-mode-btn="eclipse" data-tip="eclipse" aria-label="Eclipse mode">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="12" r="7" stroke="currentColor" stroke-width="1.4" stroke-dasharray="1.5 2" />
          <circle cx="14" cy="11" r="6" fill="#0a0b10" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
      <span class="prism-hud__sep" aria-hidden="true"></span>
      <!-- refract: shockwave rings -->
      <button type="button" class="prism-hud__pulse" id="prismPulseBtn" data-tip="refract" aria-label="Trigger refraction shockwave">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="2" fill="currentColor" stroke="none" />
          <circle cx="12" cy="12" r="5.5" stroke-width="1.4" />
          <circle cx="12" cy="12" r="9.5" stroke-width="1.1" stroke-dasharray="2 2.4" />
        </svg>
      </button>
    </div>
  </aside>
)}
