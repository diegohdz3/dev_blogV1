---
import type { CmsCanvasBlock } from '../lib/cms';

interface Props {
  blocks: CmsCanvasBlock[];
  accentColor?: string;
}

const { blocks, accentColor = '#3ddbd9' } = Astro.props;
const contentBlocks = blocks.filter((b) => b.block_type !== 'CASE_HERO');

interface RenderGroup {
  kind: 'editorial_section' | 'overview' | 'timeline' | 'challenges';
  sectionId: string;
  eyebrow?: string;
  heading?: string;
  items: CmsCanvasBlock[];
  rawBlock?: CmsCanvasBlock;
}

const groups: RenderGroup[] = [];
let currentEditorial: RenderGroup | null = null;

for (const block of contentBlocks) {
  if (block.block_type === 'OVERVIEW_SECTION') {
    currentEditorial = null;
    groups.push({
      kind: 'overview',
      sectionId: `section-${block.order_index}`,
      rawBlock: block,
      items: [],
    });
  } else if (block.block_type === 'TIMELINE_SECTION') {
    currentEditorial = null;
    groups.push({
      kind: 'timeline',
      sectionId: `section-${block.order_index}`,
      rawBlock: block,
      items: [],
    });
  } else if (block.block_type === 'CHALLENGE_CARDS') {
    currentEditorial = null;
    groups.push({
      kind: 'challenges',
      sectionId: `section-${block.order_index}`,
      rawBlock: block,
      items: [],
    });
  } else if (block.block_type === 'HEADING' && Number(block.content_payload?.level) !== 3) {
    currentEditorial = {
      kind: 'editorial_section',
      sectionId: `section-${block.order_index}`,
      eyebrow: block.content_payload?.eyebrow || `/ section 0${groups.length + 1}`,
      heading: String(block.content_payload?.text || ''),
      items: [],
    };
    groups.push(currentEditorial);
  } else {
    if (!currentEditorial) {
      currentEditorial = {
        kind: 'editorial_section',
        sectionId: `section-${block.order_index}`,
        eyebrow: block.content_payload?.eyebrow || `/ notes`,
        heading: block.content_payload?.heading ? String(block.content_payload.heading) : undefined,
        items: [],
      };
      groups.push(currentEditorial);
    }
    currentEditorial.items.push(block);
  }
}
---
<div class="th2-reader__sections" style={`--cat-color: ${accentColor}`}>
  {groups.map((group, idx) => {
    const num = String(idx + 1).padStart(2, '0');

    if (group.kind === 'overview' && group.rawBlock) {
      const payload = group.rawBlock.content_payload || {};
      const paragraphs = String(payload.text || '').split(/\n\n+/).filter(Boolean);
      return (
        <section class="th2-reader__section" id={group.sectionId} data-reader-section={group.sectionId}>
          <span class="th2__dot th2-reader__sec-dot" style={`background:${accentColor}`}></span>
          <div class="th2-reader__sec-meta">
            <span class="th2-reader__sec-num">{num}</span>
            <span class="th2-reader__sec-eyebrow" style={`color:${accentColor}`}>
              {payload.eyebrow || '/ overview'}
            </span>
          </div>
          <h2 class="th2-reader__sec-title">{payload.heading || 'Overview'}</h2>
          <div class="th2-reader__prose">
            {paragraphs.map((p: string) => (
              <p>{p}</p>
            ))}
            {Array.isArray(payload.facts) && payload.facts.length > 0 && (
              <div class="th2-reader__facts">
                {payload.facts.map((fact: { key: string; val: string }) => (
                  <div class="th2-reader__fact">
                    <span class="th2-reader__fact-key" style={`color:${accentColor}`}>&gt; {fact.key}_</span>
                    <span class="th2-reader__fact-val">{fact.val}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        </section>
      );
    }

    if (group.kind === 'timeline' && group.rawBlock) {
      const payload = group.rawBlock.content_payload || {};
      return (
        <section class="th2-reader__section" id={group.sectionId} data-reader-section={group.sectionId}>
          <span class="th2__dot th2-reader__sec-dot" style={`background:${accentColor}`}></span>
          <div class="th2-reader__sec-meta">
            <span class="th2-reader__sec-num">{num}</span>
            <span class="th2-reader__sec-eyebrow" style={`color:${accentColor}`}>
              {payload.eyebrow || '/ timeline'}
            </span>
          </div>
          <h2 class="th2-reader__sec-title">{payload.heading || 'The development process.'}</h2>
          {Array.isArray(payload.phases) && (
            <div class="th2-reader__phases">
              {payload.phases.map((phase: { phase: string; title: string; desc: string }) => (
                <div class="th2-reader__phase-card">
                  <span class="th2-reader__phase-tag" style={`color:${accentColor}`}>{phase.phase}</span>
                  <h3 class="th2-reader__phase-title">{phase.title}</h3>
                  <p class="th2-reader__phase-desc">{phase.desc}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      );
    }

    if (group.kind === 'challenges' && group.rawBlock) {
      const payload = group.rawBlock.content_payload || {};
      return (
        <section class="th2-reader__section" id={group.sectionId} data-reader-section={group.sectionId}>
          <span class="th2__dot th2-reader__sec-dot" style={`background:${accentColor}`}></span>
          <div class="th2-reader__sec-meta">
            <span class="th2-reader__sec-num">{num}</span>
            <span class="th2-reader__sec-eyebrow" style={`color:${accentColor}`}>
              {payload.eyebrow || '/ challenges'}
            </span>
          </div>
          <h2 class="th2-reader__sec-title">{payload.heading || 'What I learned.'}</h2>
          {Array.isArray(payload.cards) && (
            <div class="th2-reader__cards">
              {payload.cards.map((card: { title: string; text: string }, cIdx: number) => (
                <div class="th2-reader__card">
                  <div class="th2-reader__card-num" style={`color:${accentColor}`}>
                    {String(cIdx + 1).padStart(2, '0')}
                  </div>
                  <h3 class="th2-reader__card-title">{card.title}</h3>
                  <p class="th2-reader__card-text">{card.text}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      );
    }

    return (
      <section class="th2-reader__section" id={group.sectionId} data-reader-section={group.sectionId}>
        <span class="th2__dot th2-reader__sec-dot" style={`background:${accentColor}`}></span>
        <div class="th2-reader__sec-meta">
          <span class="th2-reader__sec-num">{num}</span>
          {group.eyebrow && (
            <span class="th2-reader__sec-eyebrow" style={`color:${accentColor}`}>
              {group.eyebrow}
            </span>
          )}
        </div>
        {group.heading && <h2 class="th2-reader__sec-title">{group.heading}</h2>}

        <div class="th2-reader__prose">
          {group.items.map((item) => {
            const p = item.content_payload || {};

            if (item.block_type === 'HEADING') {
              return <h3 class="th2-reader__subheading">{String(p.text || '')}</h3>;
            }

            if (item.block_type === 'PARAGRAPH') {
              if (p.divider) {
                return <hr class="th-article__divider" />;
              }
              const paras = String(p.text || '').split(/\n\n+/).filter(Boolean);
              const listItems = Array.isArray(p.list) ? p.list : [];
              const rawHtml =
                typeof p.html === 'string'
                  ? p.html.replace(/<\/?(?!(?:strong|b|em|i|code|a|br)\b)[^>]*>/gi, '')
                  : '';
              return (
                <>
                  {rawHtml ? <p set:html={rawHtml} /> : paras.map((para: string) => <p>{para}</p>)}
                  {listItems.length > 0 &&
                    (p.ordered ? (
                      <ol class="th-article__list th-article__list--ordered">
                        {listItems.map((li: string) => (
                          <li>{li}</li>
                        ))}
                      </ol>
                    ) : (
                      <ul class="th-article__list">
                        {listItems.map((li: string) => (
                          <li>{li}</li>
                        ))}
                      </ul>
                    ))}
                </>
              );
            }

            if (item.block_type === 'CODE') {
              return (
                <div class="th-article__code th2-reader__code">
                  <div class="th-article__code-header">
                    <span class="th-article__code-lang" style={`color:${accentColor}`}>
                      {p.language || 'code'}
                    </span>
                    <div class="th-article__code-actions">
                      {p.filename && <span class="th-article__code-file">{p.filename}</span>}
                      <button type="button" class="th-article__code-copy" data-copy-code>
                        [ copy ]
                      </button>
                    </div>
                  </div>
                  <pre><code>{p.code}</code></pre>
                </div>
              );
            }

            if (item.block_type === 'IMAGE_GALLERY') {
              const imgs = Array.isArray(p.images) ? p.images : [];
              return imgs
                .filter((img: { url?: string }) => img?.url)
                .map((img: { url: string; caption?: string }) => (
                  <figure class="th-article__figure">
                    <img src={img.url} alt={img.caption || ''} loading="lazy" />
                    {img.caption && <figcaption>{img.caption}</figcaption>}
                  </figure>
                ));
            }

            if (item.block_type === 'QUOTE' || item.block_type === 'CALLOUT') {
              const isWarn = item.block_type === 'CALLOUT' && p.tone === 'warning';
              return (
                <div
                  class:list={['th-article__callout', 'th2-reader__callout', { 'th-article__callout--warning': isWarn }]}
                >
                  <div class="th-article__callout-line" style={isWarn ? '' : `background:${accentColor}`}></div>
                  <blockquote>
                    {item.block_type === 'CALLOUT' ? (
                      p.text || p.message || p.quote
                    ) : (
                      <>&ldquo;{p.text || p.quote}&rdquo;</>
                    )}
                  </blockquote>
                </div>
              );
            }

            return null;
          })}
        </div>
      </section>
    );
  })}
</div>
