---
interface Props {
  activePage?: 'home' | 'thoughts' | 'projects' | 'about' | 'certifications' | 'contact' | 'article';
  indicator?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  activePage = 'home',
  indicator = '00 / spectrum hub',
  backHref = '/',
  backLabel = 'hub',
} = Astro.props;

const isHome = activePage === 'home';
const isInternal = backHref.startsWith('/');
const landingUrl = import.meta.env.PUBLIC_LANDING_URL || 'https://devblog33.vercel.app';

// Each section of the blog lives on its own page (multi-page blog, not a one-page landing).
const links = isHome
  ? [
      { href: '/thoughts', label: 'thoughts', active: false },
      { href: '/projects', label: 'projects', active: false },
      { href: '/about', label: 'about', active: false },
      { href: '/contact', label: 'contact', active: false },
    ]
  : [
      { href: '/thoughts', label: 'thoughts', active: activePage === 'thoughts' || activePage === 'article' },
      { href: '/projects', label: 'projects', active: activePage === 'projects' },
      { href: '/about', label: 'about', active: activePage === 'about' },
      { href: '/certifications', label: 'certs', active: activePage === 'certifications' },
      { href: '/contact', label: 'contact', active: activePage === 'contact' },
    ];
---
<nav class:list={['sub-nav', { 'sub-nav--home': isHome }]} id="subNav" aria-label="Main navigation">
  <a
    href={isHome ? landingUrl : backHref}
    class="sub-nav__back"
    data-nav={!isHome && isInternal ? '' : undefined}
    target={isHome || !isInternal ? '_blank' : undefined}
    rel={isHome || !isInternal ? 'noopener noreferrer' : undefined}
  >
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M19 12H5M5 12L12 5M5 12L12 19" />
    </svg>
    <span>{backLabel}</span>
  </a>

  <div class="sub-nav__links">
    {links.map((link) => (
      <a
        href={link.href}
        class:list={['sub-nav__link', { 'is-active': link.active }]}
        aria-current={link.active ? 'page' : undefined}
        data-nav
      >
        {link.label}
      </a>
    ))}
  </div>

  {!isHome && <div class="sub-nav__indicator" id="subNavIndicator">{indicator}</div>}
</nav>
